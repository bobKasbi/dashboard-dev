{
  "name": "sinc-shop",
  "version": "2.5.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config=proxy.conf.js",
    "build": "ng build",
    "build-watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "npx eslint src --max-warnings=999",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "lint:pipeline": "echo 'Running ESLint on TS + HTML files...' && eslint . --ext .ts,.html --max-warnings=0 --format stylish",
    "prettier:check": "prettier --config prettier.config.cjs --ignore-path .prettierignore --check .",
    "prettier:write": "prettier --config prettier.config.cjs --ignore-path .prettierignore --write .",
    "format": "npm run lint:fix && npm run prettier:write",
    "e2e": "playwright test",
    "e2e:logs": "DEBUG=pw:api playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "playwright test --reporter=list --workers=1 --forbid-only",
    "postinstall": "playwright install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.6",
    "@angular/cdk": "^20.2.13",
    "@angular/common": "^20.3.6",
    "@angular/compiler": "^20.3.6",
    "@angular/core": "^20.3.6",
    "@angular/forms": "^20.3.6",
    "@angular/material": "^20.2.13",
    "@angular/material-moment-adapter": "^20.2.9",
    "@angular/platform-browser": "^20.3.6",
    "@angular/platform-browser-dynamic": "^20.3.6",
    "@angular/router": "^20.3.6",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@ng-bootstrap/ng-bootstrap": "17.0.1",
    "bootstrap": "^5.3.3",
    "epk-forms": "^0.0.6",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "^26.2.1",
    "ngx-toastr": "^19.1.0",
    "rxjs": "~7.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.6",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "~3.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.22",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^15.0.3",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.5",
    "ts-prune": "^0.10.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.4"
  }
}
